# Legacy Deriv API app id (WebSocket ticks + optional OAuth2 bridge param)
VITE_DERIV_APP_ID=1089

# New OAuth 2.0 client id from Deriv developer dashboard
VITE_DERIV_CLIENT_ID=

# Exact redirect URI registered on the OAuth2 client (must match including trailing slash)
VITE_DERIV_REDIRECT_URI=https://www.dukehub.site/

# Optional scopes — must match scopes enabled on your Deriv OAuth2 client
# Subscriber Hub does not use new OAuth2 scopes; for trading, `trade` alone is enough
VITE_DERIV_OAUTH_SCOPES=trade
